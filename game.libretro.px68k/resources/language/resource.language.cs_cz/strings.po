msgctxt "Addon Summary"
msgid "Sharp - X68000 (PX68k)"
msgstr "Sharp - X68000 (PX68k)"

msgctxt "Addon Description"
msgid "PX68k is a portable SHARP X68000 Emulator for PSP, Android and other platforms."
msgstr "PX68k je přenositelný emulátor SHARP X68000 pro PSP, Android a další platformy."

msgctxt "#30001"
msgid "Menu Font Size"
msgstr "Velikost písma nabídky"

msgctxt "#30002"
msgid "CPU Speed"
msgstr "Rychlost CPU"

msgctxt "#30003"
msgid "RAM Size (Restart)"
msgstr "Velikost RAM (vyžaduje restart)"

msgctxt "#30004"
msgid "Use Analog"
msgstr "Používat analogové ovládání"

msgctxt "#30005"
msgid "P1 Joypad Type"
msgstr "Typ joypadu P1"

msgctxt "#30006"
msgid "P2 Joypad Type"
msgstr "Typ joypadu P2"

msgctxt "#30007"
msgid "P1 Joystick Select Mapping"
msgstr "Mapování tlačítka Select joypadu P1"

msgctxt "#30008"
msgid "ADPCM Volume"
msgstr "Hlasitost ADPCM"

msgctxt "#30009"
msgid "OPM Volume"
msgstr "Hlasitost OPM"

msgctxt "#30010"
msgid "Swap Disks on Drive"
msgstr "Jednotka pro výměnu disků"

msgctxt "#30011"
msgid "Save FDD Paths"
msgstr "Ukládat cesty k diskům FDD"

msgctxt "#30012"
msgid "Save HDD Paths"
msgstr "Ukládat cesty k diskům HDD"

msgctxt "#30013"
msgid "Rumble on FDD Reads"
msgstr "Vibrace při čtení z FDD"

msgctxt "#30014"
msgid "Joy/Mouse"
msgstr "Joypad/myš"

msgctxt "#30015"
msgid "VBtn Swap"
msgstr "Prohodit tlačítka TRIG1/TRIG2"

msgctxt "#30016"
msgid "No Wait Mode"
msgstr "Režim bez čekání"

msgctxt "#30017"
msgid "Frames Skip"
msgstr "Přeskakování snímků"

msgctxt "#30018"
msgid "Push Video before Audio"
msgstr "Odesílat video před zvukem"

msgctxt "#30019"
msgid "Adjust Frame Rates"
msgstr "Upravovat snímkové frekvence"

msgctxt "#30020"
msgid "Audio Desync Hack"
msgstr "Hack proti desynchronizaci zvuku"

msgctxt "#30021"
msgid "MIDI Output (Restart)"
msgstr "Výstup MIDI (vyžaduje restart)"

msgctxt "#30023"
msgid "MIDI Output Type"
msgstr "Typ výstupu MIDI"

msgctxt "#30024"
msgid "Text Off"
msgstr "Vypnout textovou vrstvu"

msgctxt "#30025"
msgid "Grp Off"
msgstr "Vypnout grafickou vrstvu"

msgctxt "#30026"
msgid "SP/BG Off"
msgstr "Vypnout vrstvy SP/BG"

msgctxt "#30027"
msgid "System"
msgstr "Systém"

msgctxt "#30028"
msgid "Change emulated hardware settings."
msgstr "Změnit nastavení emulovaného hardwaru."

msgctxt "#30029"
msgid "Sets the built-in menu font size"
msgstr "Nastaví velikost písma vestavěné nabídky."

msgctxt "#30030"
msgid "Configure the CPU speed. Can be used to slow down games that run too fast or to speed up floppy loading times."
msgstr "Nastaví rychlost CPU. Lze ji použít ke zpomalení her, které běží příliš rychle, nebo ke zrychlení načítání disket."

msgctxt "#30031"
msgid "Sets the amount of RAM to be used by the system."
msgstr "Nastaví množství RAM, které má systém používat."

msgctxt "#30032"
msgid "Audio"
msgstr "Zvuk"

msgctxt "#30033"
msgid "Change sound volumes and midi output type."
msgstr "Změnit hlasitost zvuku a typ výstupu MIDI."

msgctxt "#30034"
msgid "Enable software MIDI."
msgstr "Povolit softwarové MIDI."

msgctxt "#30035"
msgid "Sets MIDI output type."
msgstr "Nastaví typ výstupu MIDI."

msgctxt "#30036"
msgid "Sets the volume of the ADPCM sound channel."
msgstr "Nastaví hlasitost zvukového kanálu ADPCM."

msgctxt "#30037"
msgid "Sets the volume of the OPM sound channel."
msgstr "Nastaví hlasitost zvukového kanálu OPM."

msgctxt "#30038"
msgid "Input"
msgstr "Vstup"

msgctxt "#30039"
msgid "Change controller types and button mapping."
msgstr "Změnit typy ovladačů a mapování tlačítek."

msgctxt "#30040"
msgid "Set the joypad type for player 1."
msgstr "Nastavit typ joypadu pro hráče 1."

msgctxt "#30041"
msgid "Set the joypad type for player 2."
msgstr "Nastavit typ joypadu pro hráče 2."

msgctxt "#30042"
msgid "Assigns a keyboard key to joypad's SELECT button since some games use these keys as the Start or Insert Coin buttons."
msgstr "Přiřadí klávesu klávesnice tlačítku SELECT joypadu, protože některé hry tyto klávesy používají jako tlačítka Start nebo Insert Coin."

msgctxt "#30043"
msgid "Select [Mouse] or [Joypad] to control in-game mouse pointer."
msgstr "Vyberte [Mouse] nebo [Joypad] pro ovládání ukazatele myši ve hře."

msgctxt "#30044"
msgid "Swaps TRIG1 and TRIG2 buttons when a 2-button gamepad is selected."
msgstr "Prohodí tlačítka TRIG1 a TRIG2 při výběru dvoutlačítkového gamepadu."

msgctxt "#30045"
msgid "Media"
msgstr "Média"

msgctxt "#30046"
msgid "Change floppy disk media swapping options."
msgstr "Změnit volby výměny disket."

msgctxt "#30047"
msgid "By default using the native Disk Swap interface within RetroArch's menu will swap the disk in drive FDD1. Change this option to swap disks in drive FDD0."
msgstr "Ve výchozím nastavení nativní rozhraní Disk Swap v nabídce RetroArchu vymění disk v jednotce FDD1. Změnou této volby se budou disky vyměňovat v jednotce FDD0."

msgctxt "#30048"
msgid "When enabled, last loaded fdd path will be saved for each drive and then auto-loaded on startup. When disabled, FDDx starts empty."
msgstr "Je-li povoleno, pro každou jednotku se uloží cesta k naposledy načtenému disku FDD a při spuštění se disk automaticky načte. Je-li zakázáno, disketová jednotka FDDx se spustí prázdná."

msgctxt "#30049"
msgid "When enabled, last loaded hdd path will be saved for each drive and then auto-loaded on startup. When disabled, HDDx starts empty."
msgstr "Je-li povoleno, pro každou jednotku se uloží cesta k naposledy načtenému disku HDD a při spuštění se disk automaticky načte. Je-li zakázáno, jednotka HDDx se spustí prázdná."

msgctxt "#30050"
msgid "Produces rumble effect on supported devices when reading from floppy disks."
msgstr "Při čtení z disket vyvolává vibrace na podporovaných zařízeních."

msgctxt "#30051"
msgid "Advanced"
msgstr "Pokročilé"

msgctxt "#30052"
msgid "Change system-related advanced options for performance or aesthetics."
msgstr "Změnit pokročilé možnosti systému pro zvýšení výkonu nebo úpravu vzhledu."

msgctxt "#30053"
msgid "When set to [enabled], core runs as fast as possible. Can cause audio desync. Setting this [disabled] is recommended."
msgstr "Při nastavení na [enabled] běží jádro co nejrychleji. Může způsobit desynchronizaci zvuku. Doporučuje se nastavit [disabled]."

msgctxt "#30054"
msgid "Choose how many frames will be skipped to improve performance at the expense of visual smoothness."
msgstr "Zvolte, kolik snímků se má přeskočit pro zvýšení výkonu na úkor plynulosti obrazu."

msgctxt "#30055"
msgid "Prioritize reducing video latency over audio latency and/or stuttering."
msgstr "Upřednostnit snížení latence videa před snížením latence zvuku a/nebo zadrháváním."

msgctxt "#30056"
msgid "For compatibility with modern displays, slightly adjust frame rates reported to frontend in order to reduce the chances of audio stuttering.  Disable to use actual frame rates."
msgstr "Kvůli kompatibilitě s moderními displeji se mírně upravují snímkové frekvence hlášené frontendu, aby se snížila pravděpodobnost zadrhávání zvuku. Vypnutím se použijí skutečné snímkové frekvence."

msgctxt "#30057"
msgid "Prevents audio from desynchronizing by simply discarding any audio samples generated past the requested amount per frame slice.  Forces 'No Wait Mode' to [enabled], use appropriate frontend settings to properly throttle content."
msgstr "Zabraňuje desynchronizaci zvuku tím, že jednoduše zahazuje vzorky zvuku vytvořené nad požadované množství v každém úseku snímku. Vynutí nastavení volby „Režim bez čekání“ na [enabled]; pro správnou regulaci rychlosti obsahu použijte vhodné nastavení frontendu."

