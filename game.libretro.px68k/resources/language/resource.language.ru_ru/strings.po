msgid "4:3 (fill screen)"
msgstr ""

msgctxt "#30077"
msgid "X68000 (CRT timing)"
msgstr ""

msgctxt "#30078"
msgid "1:1 (square pixels)"
msgstr ""

msgctxt "#30079"
msgid "For compatibility with modern displays, changes the 15KHz mode from 61.46 to 60Hz. Disable to get the real machine timing."
msgstr ""

