msgstr "700 мс"

msgctxt "#30174"
msgid "1000 ms"
msgstr "1000 мс"

msgctxt "#30175"
msgid "Key Repeat Interval"
msgstr "Интервал автоповтора клавиши"

msgctxt "#30176"
msgid "Time between repeats once a held key is repeating. 'Machine' follows the X68000 setting (110 ms by default)."
msgstr "Время между повторами после начала автоповтора удерживаемой клавиши. «Machine» следует настройке X68000 (по умолчанию 110 мс)."

msgctxt "#30177"
msgid "30 ms"
msgstr "30 мс"

msgctxt "#30178"
msgid "50 ms"
msgstr "50 мс"

msgctxt "#30179"
msgid "75 ms"
msgstr "75 мс"

msgctxt "#30180"
msgid "100 ms"
msgstr "100 мс"

msgctxt "#30181"
msgid "150 ms"
msgstr "150 мс"

msgctxt "#30182"
msgid "P1 Joy2Key"
msgstr "P1 Joy2Key"

msgctxt "#30183"
msgid "Map Player 1 RetroPad inputs to X68000 keyboard keys."
msgstr "Сопоставить входы RetroPad игрока 1 с клавишами клавиатуры X68000."

msgctxt "#30184"
msgid "P1 Joy2Key UP"
msgstr "P1 Joy2Key вверх"

msgctxt "#30185"
msgid "Select a keyboard Key to assign to this logical Joy2Key action, it can then be mapped in Controls (exit and reopen the menu to refresh J2K key labels there)."
msgstr "Выберите клавишу клавиатуры для назначения на это логическое действие Joy2Key; затем её можно сопоставить в разделе «Управление» (выйдите и снова откройте меню, чтобы обновить там подписи клавиш J2K)."

msgctxt "#30186"
msgid "None"
msgstr "Нет"

msgctxt "#30187"
msgid "PX68K Menu"
