msgctxt "Addon Summary"
msgid "Sharp - X68000 (PX68k)"
msgstr "Sharp - X68000 (PX68k)"

msgctxt "Addon Description"
msgid "PX68k is a portable SHARP X68000 Emulator for PSP, Android and other platforms."
msgstr "PX68k är en portabel SHARP X68000-emulator för PSP, Android och andra plattformar."

msgctxt "#30001"
msgid "Menu Font Size"
msgstr "Storlek för menytypsnitt"

msgctxt "#30002"
msgid "CPU Speed"
msgstr "CPU-hastighet"

msgctxt "#30003"
msgid "RAM Size (Restart)"
msgstr "RAM-storlek (omstart)"

msgctxt "#30004"
msgid "Use Analog"
msgstr "Använd analog"

msgctxt "#30005"
msgid "P1 Joypad Type"
msgstr "Typ av P1-handkontroll"

msgctxt "#30006"
msgid "P2 Joypad Type"
msgstr "Typ av P2-handkontroll"

msgctxt "#30007"
msgid "P1 Joystick Select Mapping"
msgstr "Mappning för P1-styrspaksval"

msgctxt "#30008"
msgid "ADPCM Volume"
msgstr "ADPCM-volym"

msgctxt "#30009"
msgid "OPM Volume"
msgstr "OPM-volym"

msgctxt "#30010"
msgid "Swap Disks on Drive"
msgstr "Byt disketter i enhet"

msgctxt "#30011"
msgid "Save FDD Paths"
msgstr "Spara diskettsökvägar"

msgctxt "#30012"
msgid "Save HDD Paths"
msgstr "Spara hårddisksökvägar"

msgctxt "#30013"
msgid "Rumble on FDD Reads"
msgstr "Rumble vid diskettläsning"

msgctxt "#30014"
msgid "Joy/Mouse"
msgstr "Styrspak/mus"

msgctxt "#30015"
msgid "VBtn Swap"
msgstr "Byt V-knapp"

msgctxt "#30016"
msgid "No Wait Mode"
msgstr "Läge utan väntan"

msgctxt "#30017"
msgid "Frames Skip"
msgstr "Hoppa över bildrutor"

msgctxt "#30018"
msgid "Push Video before Audio"
msgstr "Skicka video före ljud"

msgctxt "#30019"
msgid "Adjust Frame Rates"
msgstr "Justera bildfrekvenser"

msgctxt "#30020"
msgid "Audio Desync Hack"
msgstr "Hack för osynkroniserat ljud"

msgctxt "#30021"
msgid "MIDI Output (Restart)"
msgstr "MIDI-utmatning (omstart)"

msgctxt "#30023"
msgid "MIDI Output Type"
msgstr "Typ av MIDI-utgång"

msgctxt "#30024"
msgid "Text Off"
msgstr "Text av"

msgctxt "#30025"
msgid "Grp Off"
msgstr "Grupp av"

msgctxt "#30026"
msgid "SP/BG Off"
msgstr "SP/BG Av"

msgctxt "#30027"
msgid "System"
msgstr "System"

msgctxt "#30028"
msgid "Change emulated hardware settings."
msgstr "Ändra inställningar för emulerad maskinvara."

msgctxt "#30029"
msgid "Sets the built-in menu font size"
msgstr "Ställer in teckenstorleken i den inbyggda menyn"

msgctxt "#30030"
msgid "Configure the CPU speed. Can be used to slow down games that run too fast or to speed up floppy loading times."
msgstr "Konfigurera CPU-hastigheten. Kan användas för att sakta ned spel som går för fort eller snabba upp inläsning från diskett."

msgctxt "#30031"
msgid "Sets the amount of RAM to be used by the system."
msgstr "Ställer in mängden RAM som används av systemet."

msgctxt "#30032"
msgid "Audio"
msgstr "Ljud"

msgctxt "#30033"
msgid "Change sound volumes and midi output type."
msgstr "Ändra ljudvolymer och typ av MIDI-utmatning."

msgctxt "#30034"
msgid "Enable software MIDI."
msgstr "Aktivera programvaru-MIDI."

msgctxt "#30035"
msgid "Sets MIDI output type."
msgstr "Ställer in typ av MIDI-utmatning."

msgctxt "#30036"
msgid "Sets the volume of the ADPCM sound channel."
msgstr "Ställer in volymen för ADPCM-ljudkanalen."

msgctxt "#30037"
msgid "Sets the volume of the OPM sound channel."
msgstr "Ställer in volymen för OPM-ljudkanalen."

msgctxt "#30038"
msgid "Input"
msgstr "Inmatning"

msgctxt "#30039"
msgid "Change controller types and button mapping."
msgstr "Ändra handkontrolltyper och knappmappning."

msgctxt "#30040"
msgid "Set the joypad type for player 1."
msgstr "Ställ in handkontrolltypen för spelare 1."

msgctxt "#30041"
msgid "Set the joypad type for player 2."
msgstr "Ställ in handkontrolltypen för spelare 2."

msgctxt "#30042"
msgid "Assigns a keyboard key to joypad's SELECT button since some games use these keys as the Start or Insert Coin buttons."
msgstr "Tilldelar en tangent till handkontrollens SELECT-knapp eftersom vissa spel använder dessa tangenter som start- eller myntknappar."

msgctxt "#30043"
msgid "Select [Mouse] or [Joypad] to control in-game mouse pointer."
msgstr "Välj [Mus] eller [Handkontroll] för att styra muspekaren i spelet."

msgctxt "#30044"
msgid "Swaps TRIG1 and TRIG2 buttons when a 2-button gamepad is selected."
msgstr "Byter knapparna TRIG1 och TRIG2 när en tvåknappshandkontroll väljs."

msgctxt "#30045"
msgid "Media"
msgstr "Media"

msgctxt "#30046"
msgid "Change floppy disk media swapping options."
msgstr "Ändra alternativ för byte av disketter."

msgctxt "#30047"
msgid "By default using the native Disk Swap interface within RetroArch's menu will swap the disk in drive FDD1. Change this option to swap disks in drive FDD0."
msgstr "Som standard byter det inbyggda gränssnittet för diskbyte i RetroArchs meny diskett i enheten FDD1. Ändra alternativet för att byta disketter i FDD0."

msgctxt "#30048"
msgid "When enabled, last loaded fdd path will be saved for each drive and then auto-loaded on startup. When disabled, FDDx starts empty."
msgstr "När detta är aktiverat sparas senast inlästa FDD-sökväg för varje enhet och läses in automatiskt vid start. När det är inaktiverat startar FDDx tom."

msgctxt "#30049"
msgid "When enabled, last loaded hdd path will be saved for each drive and then auto-loaded on startup. When disabled, HDDx starts empty."
msgstr "När detta är aktiverat sparas senast inlästa HDD-sökväg för varje enhet och läses in automatiskt vid start. När det är inaktiverat startar HDDx tom."

msgctxt "#30050"
msgid "Produces rumble effect on supported devices when reading from floppy disks."
msgstr "Ger vibrationseffekt på enheter som stöds när disketter läses."

msgctxt "#30051"
msgid "Advanced"
msgstr "Avancerat"

msgctxt "#30052"
msgid "Change system-related advanced options for performance or aesthetics."
msgstr "Ändra avancerade systemalternativ för prestanda eller utseende."

msgctxt "#30053"
msgid "When set to [enabled], core runs as fast as possible. Can cause audio desync. Setting this [disabled] is recommended."
msgstr "När inställt på [aktiverad] kör kärnan så snabbt som möjligt. Kan orsaka osynkroniserat ljud. [Inaktiverad] rekommenderas."

msgctxt "#30054"
msgid "Choose how many frames will be skipped to improve performance at the expense of visual smoothness."
msgstr "Välj hur många bildrutor som hoppas över för bättre prestanda på bekostnad av visuell jämnhet."

msgctxt "#30055"
msgid "Prioritize reducing video latency over audio latency and/or stuttering."
msgstr "Prioritera lägre videolatens framför ljudlatens och/eller hack."

msgctxt "#30056"
msgid "For compatibility with modern displays, slightly adjust frame rates reported to frontend in order to reduce the chances of audio stuttering.  Disable to use actual frame rates."
msgstr "För kompatibilitet med moderna skärmar justeras de bildfrekvenser som rapporteras till gränssnittet något för att minska risken för ljudhack. Inaktivera för att använda verkliga bildfrekvenser."

msgctxt "#30057"
msgid "Prevents audio from desynchronizing by simply discarding any audio samples generated past the requested amount per frame slice.  Forces 'No Wait Mode' to [enabled], use appropriate frontend settings to properly throttle content."
msgstr "Förhindrar osynkroniserat ljud genom att kasta bort ljudsampel som genereras utöver den begärda mängden per bildruta. Tvingar ”Läge utan väntan” till [aktiverad]; använd lämpliga inställningar i gränssnittet för att begränsa innehållet korrekt."

